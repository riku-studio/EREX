# ========================
# 📦 Application Settings
# ========================
PROJECT_NAME=erex
APP_NAME=erex-api
APP_ENV=development     # development | staging | production
DEBUG=true
PORT=8000

# ========================
# 📄 Index Rule Storage
# ========================
INDEX_RULE_SOURCE=file   # file | db
INDEX_RULES_PATH=./config/index_rules.json
INDEX_RULE_TABLE=index_rules

# ========================
# 🗄️ Database Settings (PostgreSQL)
# ========================
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASS=secret
DB_NAME=erex

# ========================
# 🌐 Frontend Settings
# ========================
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# ========================
# 🧠 Logging Settings
# ========================
LOG_LEVEL=INFO          # DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_FORMAT=plain        # plain | json
LOG_TO_FILE=false       # stdout by default

# ========================
# 🧠 Semantic Settings
# ========================
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_THRESHOLD=0.55
# cpu | gpu | auto
SEMANTIC_ACCELERATOR=cpu
# optional explicit override, e.g. cpu / cuda / cuda:0 / mps
SEMANTIC_DEVICE=
SEMANTIC_BATCH_SIZE=64
SEMANTIC_SHOW_PROGRESS=true
SEMANTIC_TEMPLATES_PATH=./backend/config/semantic_job_templates.json
SEMANTIC_POS_TEMPLATES_PATH=./backend/config/semantic_pos_templates.json
SEMANTIC_NEG_TEMPLATES_PATH=./backend/config/semantic_neg_templates.json
SEMANTIC_POS_TOP_K=3
SEMANTIC_NEGATIVE_WEIGHT=0.15
SEMANTIC_LENGTH_PENALTY=0.0
SEMANTIC_LENGTH_REWARD=0.01
SEMANTIC_CENTER_WEIGHT=0.0
SEMANTIC_CLUSTER_DELTA=0.18
SEMANTIC_CLUSTER_MIN_WINDOWS=6
SEMANTIC_CLUSTER_OVERLAP_ONLY=true
SEMANTIC_TRIM_TAIL_NEG_THRESHOLD=0.35
SEMANTIC_TRIM_TAIL_POS_THRESHOLD=0.34
SEMANTIC_TRIM_HEAD_NEG_THRESHOLD=0.55
SEMANTIC_TRIM_HEAD_POS_THRESHOLD=0.3
SEMANTIC_WINDOW_MAX_LINES=44
SEMANTIC_MIN_LINES=2
SEMANTIC_JOB_GLOBAL_THRESHOLD=0.15

# ========================
# 🔄 Pipeline Setting
# ========================
PIPELINE_STEPS="cleaner,line_filter,splitter,extractor,classifier,aggregator"

# ========================
# 🛠️ Tooling
# ========================
UV_CACHE_DIR=.uv_cache   # uv 本地缓存目录，避免权限问题
OPENAI_MODEL=gpt-5-nano
OPENAI_API_KEY=${OPENAI_API_KEY}
